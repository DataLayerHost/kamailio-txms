CORE_RPC_URL=https://node.example/rpc
CORE_RPC_METHOD=<configure-me>
CORE_RPC_USERNAME=
CORE_RPC_PASSWORD=
CORE_RPC_TOKEN=
CORE_RPC_TIMEOUT_MS=10000
CORE_RPC_TLS_VERIFY=true
TXMS_MULTIPART_TTL=3600
TXMS_MAX_MULTIPART_MESSAGES=100
TXMS_MAX_PARTS=32
TXMS_MAX_MESSAGE_BYTES=2097152
TXMS_MAX_JOBS=10000
TXMS_MAX_QUEUE_BYTES=67108864
TXMS_JOB_TTL=3600
TXMS_MAX_STATE_BYTES=33554432
TXMS_CLEANUP_INTERVAL=10
